  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo reference=\"wrist_camera_link\">\n  <sensor name=\"wrist_camera\"
    type=\"camera\">\n    <topic>wrist_camera/image_raw</topic>\n    <gz_frame_id>wrist_camera_link</gz_frame_id>\n   
    <update_rate>30</update_rate>\n    <always_on>1</always_on>\n    <visualize>false</visualize>\n   
    <camera>\n      <horizontal_fov>1.4</horizontal_fov>\n      <image>\n       
    <width>320</width>\n        <height>240</height>\n        <format>R8G8B8</format>\n     
    </image>\n      <clip>\n        <near>0.02</near>\n        <far>8.0</far>\n     
    </clip>\n      <!-- Sensor realism matters more for sim-to-real than raw prettiness:\n              
    a policy trained on noiseless, undistorted, infinitely-sharp\n              
    images has never seen what a real camera produces. -->\n      <noise>\n       
    <type>gaussian</type>\n        <mean>0.0</mean>\n        <stddev>0.012</stddev>\n     
    </noise>\n      <!-- NO <distortion> here. Gazebo Harmonic accepts the element
    and\n               then silently stops the sensor producing frames: the topic
    is\n               advertised, the model loads without error, and no image ever\n              
    arrives. Verified by adding it (cameras dead) and removing it\n              
    (30 Hz restored). If you want lens distortion, apply it\n               downstream
    on the image rather than in the sensor. -->\n    </camera>\n  </sensor>\n</gazebo>"
