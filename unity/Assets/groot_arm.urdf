<!--
  Top-level description of the GR00T test cell:
  UR5e on a pedestal + parallel gripper + wrist/scene cameras, wired to
  gz_ros2_control.

  Build it standalone with:
    xacro groot_arm.urdf.xacro ur_type:=ur5e name:=groot_arm > /tmp/robot.urdf
-->
<robot name="groot_arm">
  <!--
    Base UR robot series xacro macro.

    NOTE this is NOT a URDF. It cannot directly be loaded by consumers
    expecting a flattened '.urdf' file. See the top-level '.xacro' for that
    (but note that .xacro must still be processed by the xacro command).

    This file models the base kinematic chain of a UR robot, which then gets
    parameterised by various configuration files to convert it into a UR3(e),
    UR5(e), UR10(e) or UR16e, etc.

    NOTE the default kinematic parameters (i.e., link lengths, frame locations,
    offsets, etc) do not correspond to any particular robot. They are defaults
    only. There WILL be non-zero offsets between the Forward Kinematics results
    in TF (i.e., robot_state_publisher) and the values reported by the Teach
    Pendant.

    For accurate (and robot-specific) transforms, the 'kinematics_parameters_file'
    parameter MUST point to a .yaml file containing the appropriate values for
    the targeted robot.

    If using the UniversalRobots/Universal_Robots_ROS_Driver, follow the steps
    described in the readme of that repository to extract the kinematic
    calibration from the controller and generate the required .yaml file.

    Main author of the migration to yaml configs Ludovic Delval.

    Contributors to previous versions (in no particular order)

     - Denis Stogl
     - Lovro Ivanov
     - Felix Messmer
     - Kelsey Hawkins
     - Wim Meeussen
     - Shaun Edwards
     - Nadia Hammoudeh Garcia
     - Dave Hershberger
     - G. vd. Hoorn
     - Philip Long
     - Dave Coleman
     - Miguel Prada
     - Mathias Luedtke
     - Marcel Schnirring
     - Felix von Drigalski
     - Felix Exner
     - Jimmy Da Silva
     - Ajit Krisshna N L
     - Muhammad Asif Rana
  -->
  <!-- =========================== world =========================== -->
  <link name="world"/>
  <!-- Pedestal the arm stands on. The table surface in worlds/tabletop.sdf is
       at z=0.6, so the arm base sits flush with the work surface. -->
  <link name="pedestal_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.3"/>
      <geometry>
        <cylinder length="0.6" radius="0.08"/>
      </geometry>
      <material name="pedestal_grey">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.3"/>
      <geometry>
        <cylinder length="0.6" radius="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.3"/>
      <mass value="20.0"/>
      <inertia ixx="0.65" ixy="0.0" ixz="0.0" iyy="0.65" iyz="0.0" izz="0.064"/>
    </inertial>
  </link>
  <joint name="pedestal_joint" type="fixed">
    <parent link="world"/>
    <child link="pedestal_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- links -  main serial chain -->
  <!-- base_link serves as the root of the robot's kinematic tree. It follows REP-103
        conventions (i.e., X+ forward, Y+ left, Z+ up).
        Since some kinematic solvers forbid having inertia values attached to a root link, we've
        added the base_link_inertia link that carries the visual, collision and inertia
        information.
    -->
  <link name="base_link"/>
  <link name="base_link_inertia">
    <visual>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/visual/base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/collision/base.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00443333156" ixy="0.0" ixz="0.0" iyy="0.00443333156" iyz="0.0" izz="0.0072"/>
    </inertial>
  </link>
  <link name="shoulder_link">
    <visual>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/visual/shoulder.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/collision/shoulder.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.761"/>
      <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.00193 -0.02561"/>
      <inertia ixx="0.0070021" ixy="7.3e-07" ixz="-1.053e-05" iyy="0.00648091" iyz="0.00049994" izz="0.00657286"/>
    </inertial>
  </link>
  <link name="upper_arm_link">
    <visual>
      <origin rpy="1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0.138"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/visual/upperarm.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0.138"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/collision/upperarm.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="8.058"/>
      <origin rpy="0 0 0" xyz="-0.2125 0.0 0.11336"/>
      <inertia ixx="0.01505885" ixy="-5.4e-05" ixz="5.63e-06" iyy="0.33388086" iyz="-1.81e-06" izz="0.33247207"/>
    </inertial>
  </link>
  <link name="forearm_link">
    <visual>
      <origin rpy="1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0.007"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/visual/forearm.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0.007"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/collision/forearm.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.846"/>
      <origin rpy="0 0 0" xyz="-0.2422 0.0 0.0265"/>
      <inertia ixx="0.00399632" ixy="-1.365e-05" ixz="0.00137272" iyy="0.07879254" iyz="-6.6e-06" izz="0.0784851"/>
    </inertial>
  </link>
  <link name="wrist_1_link">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 -0.127"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/visual/wrist1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 -0.127"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/collision/wrist1.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.37"/>
      <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.01634 -0.0018"/>
      <inertia ixx="0.00165491" ixy="-2.82e-06" ixz="-4.38e-06" iyy="0.00135962" iyz="0.00010157" izz="0.00126279"/>
    </inertial>
  </link>
  <link name="wrist_2_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.0997"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/visual/wrist2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.0997"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/collision/wrist2.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.3"/>
      <origin rpy="-1.570796326794897 0 0" xyz="0.0 0.01634 -0.0018"/>
      <inertia ixx="0.00135617" ixy="-2.74e-06" ixz="4.44e-06" iyy="0.00127827" iyz="-5.048e-05" izz="0.00096614"/>
    </inertial>
  </link>
  <link name="wrist_3_link">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 -0.0005 -0.0989"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/visual/wrist3.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 -0.0005 -0.0989"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur5e/collision/wrist3.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.365"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 -0.001159"/>
      <inertia ixx="0.00018694" ixy="6e-08" ixz="-1.7e-07" iyy="0.00018908" iyz="-9.2e-07" izz="0.00025756"/>
    </inertial>
  </link>
  <!-- base_joint fixes base_link to the environment -->
  <joint name="base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.6"/>
    <parent link="pedestal_link"/>
    <child link="base_link"/>
  </joint>
  <!-- joints - main serial chain -->
  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia"/>
    <child link="shoulder_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1625"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin rpy="0 0 0" xyz="-0.425 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin rpy="0 0 0" xyz="-0.3922 0 0.1333"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 -0.0997 -2.044881182297852e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin rpy="1.570796326589793 3.141592653589793 3.141592653589793" xyz="0 0.0996 -2.042830148012698e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <link name="ft_frame"/>
  <joint name="wrist_3_link-ft_frame" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
  <link name="base"/>
  <joint name="base_link-base_fixed_joint" type="fixed">
    <!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="flange"/>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="tool0"/>
  <joint name="flange-tool0" type="fixed">
    <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="flange"/>
    <child link="tool0"/>
  </joint>
  <!-- ============================ palm ============================ -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="gripper_base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0275"/>
      <geometry>
        <box size="0.09 0.075 0.055"/>
      </geometry>
      <material name="gripper_dark">
        <color rgba="0.15 0.15 0.17 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.0275"/>
      <geometry>
        <box size="0.09 0.075 0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.0275"/>
      <mass value="0.6"/>
      <inertia ixx="6.0e-4" ixy="0.0" ixz="0.0" iyy="7.0e-4" iyz="0.0" izz="6.0e-4"/>
    </inertial>
  </link>
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <origin rpy="0 0 0" xyz="0 0.012 0.055"/>
    <axis xyz="0 1 0"/>
    <!-- Limits are deliberately WIDER than the commanded range [0, stroke].
             gz_ros2_control drives position interfaces with a force, and
             repeatedly pushing a joint into a hard stop makes the physics
             engine's joint-limit constraint lock it: the controller's output
             keeps tracking while the joint stops responding for the rest of
             the session. Both fingers used to jam exactly at 0.0 and at
             stroke. The margin means a fully open or fully closed command
             never reaches the mechanical stop. -->
    <limit effort="120.0" lower="-0.005" upper="0.045" velocity="0.15"/>
    <!-- Must stay at zero. gz_ros2_control drives position command
             interfaces with a force; Coulomb friction of even 1 N stalls a
             50 g finger outright, so the controller output tracks perfectly
             while the joint never moves. ur_description uses 0/0 on every
             arm joint for the same reason. Grip is held by CONTACT friction
             (the surface block below), not joint friction. -->
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <link name="left_finger_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0.006 0.0275"/>
      <geometry>
        <box size="0.022 0.012 0.055"/>
      </geometry>
      <material name="finger_grey">
        <color rgba="0.35 0.36 0.4 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0.006 0.0275"/>
      <geometry>
        <box size="0.022 0.012 0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.006 0.0275"/>
      <mass value="0.05"/>
      <inertia ixx="2.0e-5" ixy="0.0" ixz="0.0" iyy="2.0e-5" iyz="0.0" izz="4.0e-6"/>
    </inertial>
  </link>
  <!-- High friction + soft contact so a light object can actually be held.
           Rigid-body sims grasp badly with default mu; these values are tuned
           for the 50 g cubes in worlds/tabletop.sdf. -->
  <gazebo reference="left_finger_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1e6</kp>
    <kd>1e3</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.0</maxVel>
  </gazebo>
  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <origin rpy="0 0 0" xyz="0 -0.012 0.055"/>
    <axis xyz="0 -1 0"/>
    <!-- Limits are deliberately WIDER than the commanded range [0, stroke].
             gz_ros2_control drives position interfaces with a force, and
             repeatedly pushing a joint into a hard stop makes the physics
             engine's joint-limit constraint lock it: the controller's output
             keeps tracking while the joint stops responding for the rest of
             the session. Both fingers used to jam exactly at 0.0 and at
             stroke. The margin means a fully open or fully closed command
             never reaches the mechanical stop. -->
    <limit effort="120.0" lower="-0.005" upper="0.045" velocity="0.15"/>
    <!-- Must stay at zero. gz_ros2_control drives position command
             interfaces with a force; Coulomb friction of even 1 N stalls a
             50 g finger outright, so the controller output tracks perfectly
             while the joint never moves. ur_description uses 0/0 on every
             arm joint for the same reason. Grip is held by CONTACT friction
             (the surface block below), not joint friction. -->
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <link name="right_finger_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 -0.006 0.0275"/>
      <geometry>
        <box size="0.022 0.012 0.055"/>
      </geometry>
      <material name="finger_grey">
        <color rgba="0.35 0.36 0.4 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.006 0.0275"/>
      <geometry>
        <box size="0.022 0.012 0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 -0.006 0.0275"/>
      <mass value="0.05"/>
      <inertia ixx="2.0e-5" ixy="0.0" ixz="0.0" iyy="2.0e-5" iyz="0.0" izz="4.0e-6"/>
    </inertial>
  </link>
  <!-- High friction + soft contact so a light object can actually be held.
           Rigid-body sims grasp badly with default mu; these values are tuned
           for the 50 g cubes in worlds/tabletop.sdf. -->
  <gazebo reference="right_finger_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1e6</kp>
    <kd>1e3</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.0</maxVel>
  </gazebo>
  <!-- ===================== tool centre point ====================== -->
  <!-- Grasp frame: the CENTRE of the region enclosed by the fingers, not the
         fingertips. Putting it at the tips makes "move the TCP to the object
         centre" drive the fingers half a finger-length into whatever the
         object is resting on. This is the IK tip link used by MoveIt and the
         frame the VLA end-effector actions act in. -->
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="tcp_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.0825"/>
  </joint>
  <link name="tcp_link"/>
  <joint name="wrist_camera_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="wrist_camera_link"/>
    <origin rpy="0 -2.2865 0" xyz="0.05 0 0.025"/>
  </joint>
  <link name="wrist_camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.045 0.02"/>
      </geometry>
      <material name="camera_body">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
    </inertial>
  </link>
  <gazebo reference="wrist_camera_link">
    <sensor name="wrist_camera" type="camera">
      <topic>wrist_camera/image_raw</topic>
      <gz_frame_id>wrist_camera_link</gz_frame_id>
      <update_rate>30</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.4</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>8.0</far>
        </clip>
        <!-- Sensor realism matters more for sim-to-real than raw prettiness:
               a policy trained on noiseless, undistorted, infinitely-sharp
               images has never seen what a real camera produces. -->
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.012</stddev>
        </noise>
        <!-- NO <distortion> here. Gazebo Harmonic accepts the element and
               then silently stops the sensor producing frames: the topic is
               advertised, the model loads without error, and no image ever
               arrives. Verified by adding it (cameras dead) and removing it
               (30 Hz restored). If you want lens distortion, apply it
               downstream on the image rather than in the sensor. -->
      </camera>
    </sensor>
  </gazebo>
  <!-- Scene cam: static mast behind the arm looking down at the table. -->
  <link name="camera_mast_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.55"/>
      <geometry>
        <cylinder length="1.1" radius="0.02"/>
      </geometry>
      <material name="mast_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.55"/>
      <geometry>
        <cylinder length="1.1" radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.55"/>
      <mass value="3.0"/>
      <inertia ixx="0.303" ixy="0.0" ixz="0.0" iyy="0.303" iyz="0.0" izz="6.0e-4"/>
    </inertial>
  </link>
  <!-- Offset to the side, not straight behind the arm: a mast on the base
       axis puts the robot itself between the camera and the workspace. -->
  <joint name="camera_mast_joint" type="fixed">
    <parent link="world"/>
    <child link="camera_mast_link"/>
    <origin rpy="0 0 0" xyz="-0.50 0.85 0.6"/>
  </joint>
  <joint name="scene_camera_joint" type="fixed">
    <parent link="camera_mast_link"/>
    <child link="scene_camera_link"/>
    <origin rpy="0 0.7000 -0.7247" xyz="0 0 1.1"/>
  </joint>
  <link name="scene_camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.045 0.02"/>
      </geometry>
      <material name="camera_body">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
    </inertial>
  </link>
  <gazebo reference="scene_camera_link">
    <sensor name="scene_camera" type="camera">
      <topic>scene_camera/image_raw</topic>
      <gz_frame_id>scene_camera_link</gz_frame_id>
      <update_rate>30</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.25</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>8.0</far>
        </clip>
        <!-- Sensor realism matters more for sim-to-real than raw prettiness:
               a policy trained on noiseless, undistorted, infinitely-sharp
               images has never seen what a real camera produces. -->
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.012</stddev>
        </noise>
        <!-- NO <distortion> here. Gazebo Harmonic accepts the element and
               then silently stops the sensor producing frames: the topic is
               advertised, the model loads without error, and no image ever
               arrives. Verified by adding it (cameras dead) and removing it
               (30 Hz restored). If you want lens distortion, apply it
               downstream on the image rather than in the sensor. -->
      </camera>
    </sensor>
  </gazebo>
</robot>
