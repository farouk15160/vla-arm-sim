<?xml version="1.0"?>
<!--
  Top-level description of the GR00T test cell:
  UR5e on a pedestal + parallel gripper + wrist/scene cameras, wired to
  gz_ros2_control.

  Build it standalone with:
    xacro groot_arm.urdf.xacro ur_type:=ur5e name:=groot_arm > /tmp/robot.urdf
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">

  <xacro:arg name="name" default="groot_arm"/>
  <!-- ur3e / ur5e / ur10e / ur16e all work; the rest of the stack is sized for ur5e -->
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="tf_prefix" default=""/>

  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params"   default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params"     default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="safety_limits"     default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>

  <!-- controller yaml handed to the gz_ros2_control plugin -->
  <xacro:arg name="simulation_controllers" default="$(find groot_arm_description)/config/ros2_controllers.yaml"/>
  <xacro:arg name="ros_namespace" default=""/>
  <!-- set false to get a description suitable for RViz-only / MoveIt-only use -->
  <xacro:arg name="sim_gazebo" default="true"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find groot_arm_description)/urdf/gripper.xacro"/>
  <xacro:include filename="$(find groot_arm_description)/urdf/sensors.xacro"/>
  <xacro:include filename="$(find groot_arm_description)/urdf/groot_arm.ros2_control.xacro"/>

  <xacro:property name="tf_prefix" value="$(arg tf_prefix)"/>
  <xacro:property name="pedestal_height" value="0.6"/>
  <xacro:property name="gripper_stroke" value="0.04"/>

  <!-- =========================== world =========================== -->
  <link name="world"/>

  <!-- Pedestal the arm stands on. The table surface in worlds/tabletop.sdf is
       at z=0.6, so the arm base sits flush with the work surface. -->
  <link name="pedestal_link">
    <visual>
      <origin xyz="0 0 ${pedestal_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="${pedestal_height}"/></geometry>
      <material name="pedestal_grey"><color rgba="0.25 0.25 0.28 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${pedestal_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="${pedestal_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${pedestal_height/2}" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="0.65" ixy="0.0" ixz="0.0" iyy="0.65" iyz="0.0" izz="0.064"/>
    </inertial>
  </link>

  <joint name="pedestal_joint" type="fixed">
    <parent link="world"/>
    <child link="pedestal_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================ arm ============================ -->
  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="pedestal_link"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    force_abs_paths="$(arg sim_gazebo)">
    <origin xyz="0 0 ${pedestal_height}" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- ========================== gripper ========================== -->
  <xacro:parallel_gripper
    prefix="${tf_prefix}"
    parent="${tf_prefix}tool0"
    stroke="${gripper_stroke}"/>

  <!-- ========================== cameras ========================== -->
  <!-- Wrist cam: mounted on the palm edge and aimed directly AT the grasp point
       (tcp_link), not merely straight down the tool. The camera sits 5 cm off
       the tool axis, so at grasp range an unaimed camera puts the object in the
       corner of the frame - precisely where the policy needs to see it. Pitch
       is atan2(-dz, dx) of the camera->TCP vector; recompute it if you move the
       camera. Gazebo's optical axis is +x. -->
  <xacro:rgb_camera name="wrist_camera" parent="${tf_prefix}gripper_base_link"
                    width="640" height="480" hfov="1.4">
    <origin xyz="0.05 0 0.025" rpy="0 ${-2.2865} 0"/>
  </xacro:rgb_camera>

  <!-- Scene cam: static mast behind the arm looking down at the table. -->
  <link name="camera_mast_link">
    <visual>
      <origin xyz="0 0 0.55" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="1.1"/></geometry>
      <material name="mast_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.55" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="1.1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.55" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.303" ixy="0.0" ixz="0.0" iyy="0.303" iyz="0.0" izz="6.0e-4"/>
    </inertial>
  </link>

  <!-- Offset to the side, not straight behind the arm: a mast on the base
       axis puts the robot itself between the camera and the workspace. -->
  <joint name="camera_mast_joint" type="fixed">
    <parent link="world"/>
    <child link="camera_mast_link"/>
    <origin xyz="-0.50 0.85 0.6" rpy="0 0 0"/>
  </joint>

  <!-- Aimed at (0.46, 0, 0.62) in world coords, i.e. the middle of the cube
       field. rpy derived from that sight line; see README if you move the mast. -->
  <xacro:rgb_camera name="scene_camera" parent="camera_mast_link"
                    width="640" height="480" hfov="1.25">
    <origin xyz="0 0 1.1" rpy="0 0.7000 -0.7247"/>
  </xacro:rgb_camera>

  <!-- ======================== gazebo / control ======================== -->
  <xacro:if value="$(arg sim_gazebo)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg simulation_controllers)</parameters>
        <ros>
          <namespace>$(arg ros_namespace)</namespace>
        </ros>
      </plugin>
    </gazebo>

    <xacro:groot_arm_ros2_control
      name="$(arg name)"
      tf_prefix="$(arg tf_prefix)"
      gripper_stroke="${gripper_stroke}"/>
  </xacro:if>

</robot>
