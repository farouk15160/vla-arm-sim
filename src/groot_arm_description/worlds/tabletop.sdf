<?xml version="1.0" ?>
<!--
  Tabletop manipulation world for GR00T evaluation.

  Layout (metres, world frame at the arm base):
    table top surface   z = 0.60
    arm pedestal        origin, occupies r<0.08
    cubes               in front of the arm, x in [0.35, 0.65]
    tray                x = 0.5, y = -0.35

  Cubes are 4 cm / 50 g with high friction: heavy enough to be stable, light
  enough for the parallel gripper to actually lift in a rigid-body sim.
-->
<sdf version="1.9">
  <world name="tabletop">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <!-- Required for the camera sensors in the robot description to render. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <!-- Low ambient so the lights below actually shape the scene. High
         ambient washes everything flat, which is what made the original look
         like untextured CAD. -->
    <scene>
      <ambient>0.28 0.29 0.32 1</ambient>
      <background>0.62 0.66 0.72 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <!-- Three-point-ish rig. One warm key casting shadows, one cool fill from
         the opposite side to lift the shadow side without flattening it, and a
         soft overhead to keep the tabletop readable for the cameras. Only the
         key casts shadows: multiple shadow-casting lights are expensive and
         produce competing shadows that read as noise. -->
    <light type="directional" name="key">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 0.96 0.88 1</diffuse>
      <specular>0.35 0.34 0.30 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.45 0.35 -0.82</direction>
    </light>

    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.34 0.38 0.46 1</diffuse>
      <specular>0.04 0.04 0.06 1</specular>
      <direction>0.6 -0.45 -0.5</direction>
    </light>

    <light type="point" name="overhead">
      <pose>0.5 0.0 2.3 0 0 0</pose>
      <diffuse>0.55 0.54 0.50 1</diffuse>
      <specular>0.10 0.10 0.09 1</specular>
      <attenuation>
        <range>9</range>
        <constant>0.3</constant>
        <linear>0.12</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.30 0.30 0.33 1</ambient>
            <diffuse>0.46 0.47 0.50 1</diffuse>
            <specular>0.10 0.10 0.11 1</specular>
            <pbr>
              <metal>
                <roughness>0.85</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================ table ============================ -->
    <model name="work_table">
      <static>true</static>
      <pose>0.50 0 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 0.575 0 0 0</pose>
          <geometry><box><size>1.4 1.8 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.575 0 0 0</pose>
          <geometry><box><size>1.4 1.8 0.05</size></box></geometry>
          <material>
            <ambient>0.52 0.51 0.49 1</ambient>
            <diffuse>0.78 0.77 0.74 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://groot_arm_description/materials/textures/bench.png</albedo_map>
                <roughness>0.68</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="leg_collision">
          <pose>0 0 0.275 0 0 0</pose>
          <geometry><box><size>1.2 1.6 0.55</size></box></geometry>
        </collision>
        <visual name="leg_visual">
          <pose>0 0 0.275 0 0 0</pose>
          <geometry><box><size>1.2 1.6 0.55</size></box></geometry>
          <material>
            <ambient>0.14 0.14 0.16 1</ambient>
            <diffuse>0.26 0.27 0.30 1</diffuse>
            <specular>0.30 0.30 0.32 1</specular>
            <pbr>
              <metal>
                <roughness>0.4</roughness>
                <metalness>0.75</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Back wall: gives the cameras a bounded scene instead of grey void,
         which also makes the VLA's visual context less ambiguous. -->
    <model name="wall_far">
      <static>true</static>
      <pose>2.1 0 1.4 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.06 6.0 2.8</size></box></geometry>
          <material>
            <ambient>0.40 0.42 0.45 1</ambient>
            <diffuse>0.60 0.62 0.66 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://groot_arm_description/materials/textures/wall.png</albedo_map>
                <roughness>0.95</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.06 6.0 2.8</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="wall_right">
      <static>true</static>
      <pose>0 -2.0 1.4 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>6.0 0.06 2.8</size></box></geometry>
          <material>
            <ambient>0.40 0.42 0.45 1</ambient>
            <diffuse>0.60 0.62 0.66 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://groot_arm_description/materials/textures/wall.png</albedo_map>
                <roughness>0.95</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>6.0 0.06 2.8</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="wall_back">
      <static>true</static>
      <pose>-1.6 0 1.4 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.06 6.0 2.8</size></box></geometry>
          <material>
            <ambient>0.40 0.42 0.45 1</ambient>
            <diffuse>0.60 0.62 0.66 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://groot_arm_description/materials/textures/wall.png</albedo_map>
                <roughness>0.95</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.06 6.0 2.8</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============================ cubes ============================ -->
    <!-- Each cube is a separate model so it can be reset/respawned per episode
         by groot_vla's scene_manager. -->
    <model name="red_cube">
      <pose>0.45 0.16 0.62 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>1e3</kd><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.5 0.05 0.05 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
            <specular>0.35 0.35 0.35 1</specular>
            <pbr>
              <metal>
                <roughness>0.35</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="green_cube">
      <pose>0.55 -0.05 0.62 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>1e3</kd><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.4 0.05 1</ambient>
            <diffuse>0.1 0.8 0.1 1</diffuse>
            <specular>0.35 0.35 0.35 1</specular>
            <pbr>
              <metal>
                <roughness>0.35</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_cube">
      <pose>0.38 -0.18 0.62 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>1e3</kd><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.5 1</ambient>
            <diffuse>0.1 0.2 0.9 1</diffuse>
            <specular>0.35 0.35 0.35 1</specular>
            <pbr>
              <metal>
                <roughness>0.35</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================== target tray ========================= -->
    <model name="tray">
      <static>true</static>
      <pose>0.5 -0.35 0.6 0 0 0</pose>
      <link name="link">
        <visual name="base_visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.22 0.22 0.01</size></box></geometry>
          <material>
            <ambient>0.22 0.23 0.25 1</ambient>
            <diffuse>0.55 0.57 0.60 1</diffuse>
            <specular>0.60 0.60 0.62 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://groot_arm_description/materials/textures/metal.png</albedo_map>
                <roughness>0.28</roughness>
                <metalness>0.9</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="base_collision">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.22 0.22 0.01</size></box></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
