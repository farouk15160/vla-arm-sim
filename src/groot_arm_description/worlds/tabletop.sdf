<?xml version="1.0" ?>
<!--
  Tabletop manipulation world for GR00T evaluation.

  Layout (metres, world frame at the arm base):
    table top surface   z = 0.60
    arm pedestal        origin, occupies r<0.08
    cubes               in front of the arm, x in [0.35, 0.65]
    tray                x = 0.5, y = -0.35

  Cubes are 4 cm / 50 g with high friction: heavy enough to be stable, light
  enough for the parallel gripper to actually lift in a rigid-body sim.
-->
<sdf version="1.9">
  <world name="tabletop">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <!-- Required for the camera sensors in the robot description to render. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- fill light so the wrist camera is not looking into shadow -->
    <light type="point" name="fill">
      <pose>-0.6 0.6 1.8 0 0 0</pose>
      <diffuse>0.4 0.4 0.45 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.4</constant>
        <linear>0.2</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.3 0.3 0.32 1</ambient>
            <diffuse>0.4 0.4 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================ table ============================ -->
    <model name="work_table">
      <static>true</static>
      <pose>0.50 0 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 0.575 0 0 0</pose>
          <geometry><box><size>1.4 1.8 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.575 0 0 0</pose>
          <geometry><box><size>1.4 1.8 0.05</size></box></geometry>
          <material>
            <ambient>0.45 0.35 0.25 1</ambient>
            <diffuse>0.65 0.5 0.35 1</diffuse>
          </material>
        </visual>
        <collision name="leg_collision">
          <pose>0 0 0.275 0 0 0</pose>
          <geometry><box><size>1.2 1.6 0.55</size></box></geometry>
        </collision>
        <visual name="leg_visual">
          <pose>0 0 0.275 0 0 0</pose>
          <geometry><box><size>1.2 1.6 0.55</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.3 0.3 0.32 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Back wall: gives the cameras a bounded scene instead of grey void,
         which also makes the VLA's visual context less ambiguous. -->
    <model name="back_wall">
      <static>true</static>
      <pose>-0.9 0 1.2 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.05 4.0 2.4</size></box></geometry>
          <material>
            <ambient>0.42 0.44 0.48 1</ambient>
            <diffuse>0.55 0.58 0.62 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.05 4.0 2.4</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============================ cubes ============================ -->
    <!-- Each cube is a separate model so it can be reset/respawned per episode
         by groot_vla's scene_manager. -->
    <model name="red_cube">
      <pose>0.45 0.16 0.62 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>1e3</kd><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.5 0.05 0.05 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="green_cube">
      <pose>0.55 -0.05 0.62 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>1e3</kd><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.4 0.05 1</ambient>
            <diffuse>0.1 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_cube">
      <pose>0.38 -0.18 0.62 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>1e3</kd><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.5 1</ambient>
            <diffuse>0.1 0.2 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================== target tray ========================= -->
    <model name="tray">
      <static>true</static>
      <pose>0.5 -0.35 0.6 0 0 0</pose>
      <link name="link">
        <visual name="base_visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.22 0.22 0.01</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.18 1</ambient>
            <diffuse>0.25 0.25 0.3 1</diffuse>
          </material>
        </visual>
        <collision name="base_collision">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.22 0.22 0.01</size></box></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
