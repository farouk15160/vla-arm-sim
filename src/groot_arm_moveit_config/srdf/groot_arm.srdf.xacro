<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic description for the UR5e + parallel gripper cell.

  Planning groups:
    ur_manipulator - base_link .. tcp_link (IK tip is the grasp frame, NOT
                     tool0, so Cartesian goals are expressed where the object
                     actually gets picked up)
    gripper        - the two finger joints
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:arg name="name" default="groot_arm"/>
  <xacro:arg name="tf_prefix" default=""/>

  <xacro:property name="p" value="$(arg tf_prefix)"/>

  <!-- ============================ groups ============================ -->
  <group name="ur_manipulator">
    <chain base_link="${p}base_link" tip_link="${p}tcp_link"/>
  </group>

  <group name="gripper">
    <joint name="${p}left_finger_joint"/>
    <joint name="${p}right_finger_joint"/>
  </group>

  <end_effector name="gripper_ee" parent_link="${p}tcp_link"
                group="gripper" parent_group="ur_manipulator"/>

  <!-- ========================= group states ========================= -->
  <!-- 'home' is a compact, singularity-free posture above the table with the
       tool pointing down; it is the reset pose used between episodes. -->
  <group_state name="home" group="ur_manipulator">
    <joint name="${p}shoulder_pan_joint"  value="0.0"/>
    <joint name="${p}shoulder_lift_joint" value="-1.5708"/>
    <joint name="${p}elbow_joint"         value="1.5708"/>
    <joint name="${p}wrist_1_joint"       value="-1.5708"/>
    <joint name="${p}wrist_2_joint"       value="-1.5708"/>
    <joint name="${p}wrist_3_joint"       value="0.0"/>
  </group_state>

  <!-- Camera-friendly observation pose: arm retracted, wrist cam sees the
       whole table. Good starting state for a VLA rollout. -->
  <group_state name="observe" group="ur_manipulator">
    <joint name="${p}shoulder_pan_joint"  value="0.0"/>
    <joint name="${p}shoulder_lift_joint" value="-1.2217"/>
    <joint name="${p}elbow_joint"         value="1.2217"/>
    <joint name="${p}wrist_1_joint"       value="-1.5708"/>
    <joint name="${p}wrist_2_joint"       value="-1.5708"/>
    <joint name="${p}wrist_3_joint"       value="0.0"/>
  </group_state>

  <group_state name="up" group="ur_manipulator">
    <joint name="${p}shoulder_pan_joint"  value="0.0"/>
    <joint name="${p}shoulder_lift_joint" value="-1.5708"/>
    <joint name="${p}elbow_joint"         value="0.0"/>
    <joint name="${p}wrist_1_joint"       value="-1.5708"/>
    <joint name="${p}wrist_2_joint"       value="0.0"/>
    <joint name="${p}wrist_3_joint"       value="0.0"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="${p}left_finger_joint"  value="0.04"/>
    <joint name="${p}right_finger_joint" value="0.04"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="${p}left_finger_joint"  value="0.0"/>
    <joint name="${p}right_finger_joint" value="0.0"/>
  </group_state>

  <!-- ====================== disable collisions ====================== -->
  <!-- arm chain (mirrors ur_moveit_config) -->
  <disable_collisions link1="${p}base_link"          link2="${p}base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="${p}base_link_inertia"  link2="${p}shoulder_link"     reason="Adjacent"/>
  <disable_collisions link1="${p}shoulder_link"      link2="${p}upper_arm_link"    reason="Adjacent"/>
  <disable_collisions link1="${p}forearm_link"       link2="${p}upper_arm_link"    reason="Adjacent"/>
  <disable_collisions link1="${p}forearm_link"       link2="${p}wrist_1_link"      reason="Adjacent"/>
  <disable_collisions link1="${p}wrist_1_link"       link2="${p}wrist_2_link"      reason="Adjacent"/>
  <disable_collisions link1="${p}wrist_1_link"       link2="${p}wrist_3_link"      reason="Never"/>
  <disable_collisions link1="${p}wrist_2_link"       link2="${p}wrist_3_link"      reason="Adjacent"/>

  <!-- pedestal: the arm base is bolted to it -->
  <disable_collisions link1="pedestal_link" link2="${p}base_link"         reason="Adjacent"/>
  <disable_collisions link1="pedestal_link" link2="${p}base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="pedestal_link" link2="${p}shoulder_link"     reason="Never"/>

  <!-- gripper body vs the wrist it is bolted to -->
  <disable_collisions link1="${p}gripper_base_link" link2="${p}wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="${p}gripper_base_link" link2="${p}wrist_2_link" reason="Never"/>
  <disable_collisions link1="${p}gripper_base_link" link2="${p}wrist_1_link" reason="Never"/>

  <!-- fingers: against the palm, against each other, and against the wrist -->
  <disable_collisions link1="${p}left_finger_link"  link2="${p}gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="${p}right_finger_link" link2="${p}gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="${p}left_finger_link"  link2="${p}right_finger_link" reason="Never"/>
  <disable_collisions link1="${p}left_finger_link"  link2="${p}wrist_3_link"      reason="Never"/>
  <disable_collisions link1="${p}right_finger_link" link2="${p}wrist_3_link"      reason="Never"/>
  <disable_collisions link1="${p}left_finger_link"  link2="${p}wrist_2_link"      reason="Never"/>
  <disable_collisions link1="${p}right_finger_link" link2="${p}wrist_2_link"      reason="Never"/>

  <!-- wrist camera rides on the gripper -->
  <disable_collisions link1="wrist_camera_link" link2="${p}gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_camera_link" link2="${p}left_finger_link"  reason="Never"/>
  <disable_collisions link1="wrist_camera_link" link2="${p}right_finger_link" reason="Never"/>
  <disable_collisions link1="wrist_camera_link" link2="${p}wrist_3_link"      reason="Never"/>
  <disable_collisions link1="wrist_camera_link" link2="${p}wrist_2_link"      reason="Never"/>

  <!-- static camera mast is well clear of the workspace -->
  <disable_collisions link1="camera_mast_link" link2="scene_camera_link" reason="Adjacent"/>
  <disable_collisions link1="camera_mast_link" link2="pedestal_link"     reason="Never"/>
  <disable_collisions link1="camera_mast_link" link2="${p}base_link"     reason="Never"/>
  <disable_collisions link1="camera_mast_link" link2="${p}base_link_inertia" reason="Never"/>

</robot>
