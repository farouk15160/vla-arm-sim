# ---- colcon build artefacts -------------------------------------------------
build/
install/
log/

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg

# ---- recorded data and trained weights --------------------------------------
# Everything the pipeline produces lives under data/ and is deliberately NOT
# tracked: a single training checkpoint is 1.3 GB and a 41-episode recording is
# 312 MB. Record your own with `episode_recorder`, convert with
# `export_lerobot`. See data/README.md for the layout.
data/
# Third-party CC0 textures, ~25 MB. Fetch with
# src/groot_arm_description/materials/fetch_ambientcg.sh
src/groot_arm_description/materials/ambientcg/
# Third-party clone; recreate with unity/setup_unity_bridge.sh
src/ros_tcp_endpoint/
# Unity Editor generates these; only Assets/ and Packages/ are ours
unity/Library/
unity/Temp/
unity/Logs/
unity/UserSettings/
unity/obj/
*.csproj
*.sln
groot_episodes/
groot_lerobot/
*.safetensors
*.ckpt
*.pt
*.pth
*.mp4

# ---- policy virtualenvs -----------------------------------------------------
# These live in $HOME by default (~/vla_venv, ~/openvla_venv); ignored here in
# case anyone creates them inside the workspace.
vla_venv/
openvla_venv/
.venv/
venv/

# ---- editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
